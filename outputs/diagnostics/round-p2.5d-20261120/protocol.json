  "definitions": {
    "xi_window": "R1 逐窗反解：xi = dry*(plant_CO2 - model_CO2)/(100 - plant_CO2)，model_CO2 = baseline 的变换前 CO2_vol_pct（不是 *_xi 列）",
    "xi_phase_constant": "P2.2-A baseline 的 xi_mol_s（每阶段一个唯一值）",
    "F_i": "F_i = 组成 vol% × dry_total / 100 (mol/s)",
    "shifted_model": "CO=(F_CO-d)/(dry+d)*100, CO2=(F_CO2+d)/(dry+d)*100, H2=(F_H2+d)/(dry+d)*100，d 即 ξ",
    "R2_estimator": "只拟合 ξ 一个参数；模型 dry 固定；Σ_comp=diag(0.5²,0.3²,0.5²)；χ²=yᵀΣ⁻¹y；dof=rank(Σ)-1=2；阈值 5.99",
    "R2_solver": "dχ²/dξ 在扫描区间内变号后用 brentq 求根（xtol=1e-14），否则退回 bounded 最小化并显式记录",
    "compatible": "chi2 <= 5.99（逐窗）",
    "R3": "Spearman ρ(ξ, T_out_K) 与 ρ(ξ/dry, T_out_K)，双侧 p",
    "R3_verdict": "ρ>0.3 且 p<0.05→consistent_with_HA_direction；ρ<-0.3→opposite_to_HA_direction；其余 no_directional_signal",
    "R4_Q": "Q = n_CO2*n_H2/(n_CO*n_H2O)，n_i 由 *_xi 列 ×(dry+ξ) 换算（阶段常数 ξ）",
    "R4_H2O": "主口径 F_H2O=(y/(1-y))*dry_total（卡片 §2.4 字面）；备查口径 F_H2O=(y/(1-y))*(dry+ξ)，两口径都写入 CSV",
    "R4_T_eq": "解 K_WGS(T)=Q，K 用 model.kinetics.calculate_wgs_equilibrium（模型自身 Gibbs）",
    "R4_drift": "drift(y) = median(T_eq|y) − median(T_eq|y=10%)，单位 K",
    "R4_usability": "max|drift| ≤50 K usable；>150 K no_information；其间 marginal",
    "CV": "样本标准差(ddof=1)/均值",
    "U1": "诊断项，不是停止条件",
    "U2": "3 窗独立重算：由 (F_CO2+ξ)/(dry+ξ)*100 = plant_CO2 解 ξ，与卡片公式互为独立推导",
